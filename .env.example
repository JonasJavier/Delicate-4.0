# Copy to .env at the repository root for local development.
# Never commit the real .env file.

# --- Django -------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_PATH=backend/db.sqlite3
# DATABASE_URL=postgresql://user:password@host:5432/database
# DJANGO_MEDIA_ROOT=/data/media
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Behind a proxy that terminates HTTPS (enabled automatically on Railway).
# DJANGO_TRUST_PROXY_SSL_HEADER=True
# DJANGO_NUM_PROXIES=1

# --- Storefront (embedded at build time) -------------------------------
VITE_API_URL=/api
VITE_WHATSAPP_NUMBER=18498625049
VITE_WHATSAPP_DISPLAY="(849) 862-5049"
VITE_ENABLE_DEMO_CATALOG=true
# Public URL used for link previews and the canonical tag.
# VITE_SITE_URL=https://www.example.com
